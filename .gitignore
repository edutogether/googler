# Dependencies
node_modules/

# Production build
dist/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating system files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Local Claude Code settings (per-machine permission overrides)
.claude/settings.local.json

# Agent worktrees (nested repo checkouts left behind by isolated subagent runs)
.claude/worktrees/
.claude/scheduled_tasks.lock

# Secrets — this repo passes the Firebase service account through GitHub
# secrets and never as a file, so these patterns are purely a guard against
# one being dropped in by hand (CONVENTIONS §7)
*.pem
cert/
serviceAccount*.json
_backups/

# Visual regression artifacts (machine-specific renderings)
.visual-baselines/
.visual-diffs/
