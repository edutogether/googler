rules_version = '2';

// Data model (see src/data/firebase/firebaseServices.ts):
//   artifacts/{appId}/users/{uid}/profile/info          — private profile
//   artifacts/{appId}/users/{uid}/user_progress/gpass_data — private progress
//   artifacts/{appId}/public/data/rankings/{uid}        — public leaderboard entry
//
// Without these rules, Firestore's default (once security rules exist at all)
// denies everything; but with NO rules file at all — the state this repo was
// in — a freshly created Firestore database is wide open. The leaderboard in
// particular writes a document whose ID is the client-supplied uid, so an
// unauthenticated ruleset lets anyone overwrite anyone else's score.

service cloud.firestore {
  match /databases/{database}/documents {
    // A user's own profile and progress: only that signed-in user may read
    // or write it.
    match /artifacts/{appId}/users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public leaderboard: anyone may read it (it's a leaderboard), but a
    // write must come from the signed-in user it claims to be — both the
    // document ID and the uid field inside the entry must match the caller,
    // so no one can write to, or masquerade as, another entrant.
    match /artifacts/{appId}/public/data/rankings/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
    }

    // Everything else: denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
