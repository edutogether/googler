rules_version = '2';

// Data model (see src/data/firebase/firebaseServices.ts):
//   artifacts/gpass-custom-app-id/users/{uid}/profile/info          — private profile
//   artifacts/gpass-custom-app-id/users/{uid}/user_progress/gpass_data — private progress
//   artifacts/gpass-custom-app-id/public/data/rankings/{uid}        — public leaderboard entry
//
// Without these rules, Firestore's default (once security rules exist at all)
// denies everything; but with NO rules file at all — the state this repo was
// in — a freshly created Firestore database is wide open. The leaderboard in
// particular writes a document whose ID is the client-supplied uid, so an
// unauthenticated ruleset lets anyone overwrite anyone else's score.
//
// The namespace segment is the literal 'gpass-custom-app-id' — the only value
// the client uses (firebaseServices.ts: VITE_FIRESTORE_NAMESPACE ?? that
// default). If the client's namespace is ever changed, change it here too, or
// every write will be denied.

service cloud.firestore {
  match /databases/{database}/documents {
    // A user's own profile and progress: only that signed-in user may read
    // or write it, and only at the two concrete document paths the client
    // actually writes (see firebaseServices.ts) — narrowed from an earlier
    // {document=**} wildcard so a signed-in user can't create arbitrary
    // extra documents/collections under their own uid, and each document is
    // shape-validated the same way the leaderboard entry already was.
    match /artifacts/gpass-custom-app-id/users/{uid}/profile/info {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'emoji'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 30
        && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8;
    }

    match /artifacts/gpass-custom-app-id/users/{uid}/user_progress/gpass_data {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['progress'])
        && request.resource.data.progress is map;
    }

    // Public leaderboard: read is restricted to signed-in participants (not
    // fully public) per the founder's confirmed decision — see CLAUDE.md
    // "재배선 관련 대표 결정 사항". A write must come from the signed-in user
    // it claims to be — both the document ID and the uid field inside the
    // entry must match the caller, so no one can write to, or masquerade as,
    // another entrant. The write also has to match this exact shape: no
    // extra fields, and each field bounded in type/length/range — Firestore
    // rules have no single "document byte size" check, so bounding every
    // allowed field is what stands in for a size limit here.
    //
    // The score ceiling (30) is the real maximum: each level has 30 missions
    // (10 days x 3), and the client's score is the count of completed ones
    // (src/domain/progress.ts countCompletedMissions). Rules check shape and
    // range only — they cannot recompute the score or verify passedL1/passedL2,
    // which come from the client. Server-side scoring is for the rewiring round.
    // src/data/firebase/firestoreRulesContent.test.ts fails if 30 drifts from
    // the actual mission counts in src/content/courses.ts.
    match /artifacts/gpass-custom-app-id/public/data/rankings/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'emoji', 'scoreL1', 'scoreL2', 'passedL1', 'passedL2'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 30
        && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
        && (!('scoreL1' in request.resource.data) || (request.resource.data.scoreL1 is int && request.resource.data.scoreL1 >= 0 && request.resource.data.scoreL1 <= 30))
        && (!('scoreL2' in request.resource.data) || (request.resource.data.scoreL2 is int && request.resource.data.scoreL2 >= 0 && request.resource.data.scoreL2 <= 30))
        && (!('passedL1' in request.resource.data) || request.resource.data.passedL1 is bool)
        && (!('passedL2' in request.resource.data) || request.resource.data.passedL2 is bool);
    }

    // Everything else: denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
