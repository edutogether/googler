{
  "name": "googler",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run build",
    "visual": "node scripts/visual-regression.mjs",
    "visual:update": "node scripts/visual-regression.mjs --update",
    "rules:test": "firebase emulators:exec --only firestore \"vitest run src/data/firebase/firestore.rules.test.ts\""
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.39.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "morgan": "1.12.1",
    "js-yaml": "4.3.2",
    "hono": "4.13.13",
    "csv-parse": "7.0.2",
    "qs": "6.16.0",
    "basic-ftp": "6.2.3",
    "chokidar": "4.0.3",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.7"
    },
    "google-gax": {
      "@grpc/grpc-js": "1.14.6"
    },
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.12.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "firebase-tools": "^15.33.0",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
